#compdef ttcli

# Zsh completion for ttcli. Install:
#   make install-completions
# or manually:
#   cp completions/_ttcli ~/.config/zsh/completions/_ttcli

_ttcli() {
  local -a commands subcmd
  commands=(
    'login:1Password session'
    'status:version and auth health'
    'ls:list projects'
    'tree:folder tree'
    'folder:manage folders'
    'project:manage lists'
    'tasks:list tasks'
    'add:create task'
    'edit:edit task'
    'due:reschedule task'
    'done:complete task'
    'rm:delete task'
    'focus:pomodoro summary and live timer'
    'pomo:short pomodoro line'
    'tui:interactive browser (tasks/calendar/pomo/habits)'
    'shell:interactive REPL'
    'help:help [cmd|gum|bt]'
    'raw:debug API'
    'version:print version'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  case "$words[2]" in
    help)
      subcmd=(gum gum-menu bt bubbletea-tui)
      local -a topics
      topics=(gum bt tui login status ls tree folder project tasks add edit due done rm focus pomo shell raw version)
      if (( CURRENT == 3 )); then
        _describe 'help topic' topics
      fi
      ;;
    folder)
      subcmd=(ls add rename rm)
      if (( CURRENT == 3 )); then
        _describe 'folder command' subcmd
      fi
      ;;
    project|list)
      subcmd=(add rename move rm)
      if (( CURRENT == 3 )); then
        _describe 'project command' subcmd
      fi
      ;;
    tasks)
      _arguments '1:project:(all)' '--completed[show completed tasks]'
      ;;
    ls|lists|projects)
      _arguments '--tree[folder tree]' '--names[names only]' '--all[include closed]'
      ;;
    status)
      _arguments '--ping[verify API]'
      ;;
    focus)
      if (( CURRENT == 3 )); then
        subcmd=(start stop pause resume status)
        _describe 'focus command' subcmd
      elif (( CURRENT > 3 )) && [[ "$words[3]" == start ]]; then
        _arguments \
          '--duration[minutes]:minutes:' \
          '--task[task id or title]:task:' \
          '--project[list]:project:' \
          '--title[create task and focus]:title:' \
          '--no-sync[skip TickTick log on stop]'
      elif (( CURRENT > 3 )) && [[ "$words[3]" == stop ]]; then
        _arguments '--no-sync[skip TickTick log]'
      else
        _arguments '--short[one-line status or tmux summary]'
      fi
      ;;
  esac
}

compdef _ttcli ttcli
